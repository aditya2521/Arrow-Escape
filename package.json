{
  "name": "arrow-escape",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node api.js && expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "precompute-levels": "tsx scripts/precomputeLevels.ts",
    "android:bundle": "cd android && ./gradlew :app:bundleRelease && python3 ../scripts/verify-android-page-sizes.py app/build/outputs/bundle/release/app-release.aab"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ]
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "expo": "~52.0.49",
    "expo-av": "~15.0.2",
    "expo-haptics": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.77.3",
    "react-native-gesture-handler": "~2.22.0",
    "react-native-reanimated": "~3.17.5",
    "react-native-safe-area-context": "~5.1.0",
    "react-native-screens": "~4.8.0",
    "react-native-svg": "^15.8.0",
    "react-native-web": "^0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~18.3.12",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.3.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native@0.76.9",
        "react-native-reanimated@~3.16.1",
        "react-native-gesture-handler@~2.20.2",
        "react-native-screens@~4.4.0",
        "react-native-safe-area-context@4.12.0"
      ]
    }
  }
}
