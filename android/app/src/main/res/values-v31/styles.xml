<resources>
  <!-- Android 12+ renders a system splash before MainActivity exists. Keep
       its background in sync with Expo's splash to avoid the default white
       launch screen on physical devices. -->
  <style name="Theme.App.SplashScreen" parent="AppTheme">
    <item name="android:windowSplashScreenBackground">@color/splashscreen_background</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/splashscreen_logo</item>
    <item name="android:windowSplashScreenAnimationDuration">200</item>
    <item name="android:windowBackground">@drawable/ic_launcher_background</item>
    <item name="android:windowDisablePreview">false</item>
  </style>
</resources>
